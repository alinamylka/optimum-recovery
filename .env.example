# The address people type. Any name pointing at the server works; sslip.io
# needs no account: <anything>.<ip-with-dashes>.sslip.io resolves to that IP.
DOMAIN=optimum-recovery.140-238-210-16.sslip.io
# First start only: seeds the logins (comma separated). Afterwards users are
# managed on the Users page and these values are ignored.
USERS=alina:change-me,arek:change-me
# Which of them are admins (see every athlete, manage users); the rest are coaches.
ADMINS=alina

# Monday email (optional). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=the address,
# SMTP_PASSWORD=an app password (Google account → Security → App passwords).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Optimum Recovery <address@gmail.com>
